{
  "name": "@tummycrypt/tinyland-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Calendar system with CalDAV, iCal, RRULE, and timezone support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "publint": "^0.3.18",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-calendar.git"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-calendar",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-calendar/issues"
  }
}
